# Path to the Firebase service-account JSON. Keep that file outside this repo.
# Do not put the private key in this file.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\YOUR_WINDOWS_USER\AppData\Local\pippinway\firebase-adminsdk.json

# Persistent Signals worker (REQUIRED for Production Top 100 pattern scanning).
# Runs Binance + the Signals engine on this host, then publishes to Firestore.
#   npm run monitor:worker
SIGNALS_MONITOR_INTERVAL_MS=60000
SIGNALS_PRICE_INTERVAL_MS=60000
SIGNALS_ANALYSIS_INTERVAL_MS=300000
# engine = local Binance+engine (default). http = legacy POST to SIGNALS_MONITOR_URL.
SIGNALS_WORKER_MODE=engine
# Optional: re-enable strict fee-aware net R/R ≥ 3 publication floor (off by default for legacy pattern path).
# SIGNALS_REQUIRE_NET_RR=1

# Legacy HTTP ping target (only used when SIGNALS_WORKER_MODE=http).
SIGNALS_MONITOR_SECRET=
SIGNALS_MONITOR_URL=http://127.0.0.1:3012

# Set to 1 only on a long-lived Node process, never on Vercel.
SIGNALS_MONITOR_INLINE=

# Emergency overrides (do not set on Production Vercel):
# SIGNALS_ALLOW_BINANCE_ON_VERCEL=1
# SIGNALS_FORCE_LIVE_SCAN=1
# SIGNALS_READ_PUBLISHED_SNAPSHOT=1
