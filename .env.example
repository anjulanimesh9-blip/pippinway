# Path to the Firebase service-account JSON. Keep that file outside this repo.
# Do not put the private key in this file.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\YOUR_WINDOWS_USER\AppData\Local\pippinway\firebase-adminsdk.json

# Persistent monitor worker. Vercel Cron is only a 60s ping, not a long-running process.
SIGNALS_MONITOR_SECRET=
SIGNALS_MONITOR_URL=http://127.0.0.1:3012
# Set to 1 only on a long-lived Node process, never as the only production scheduler on Vercel.
SIGNALS_MONITOR_INLINE=
